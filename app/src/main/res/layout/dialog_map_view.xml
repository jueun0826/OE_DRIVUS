<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#F8FAFC"
    android:padding="20dp">

    <!-- 지도 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvMapTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🗺️ 친구 실시간 위치 &amp; 목적지 지도"
            android:textColor="#1E293B"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMapStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● 실시간 추적 중"
            android:textColor="#0284C7"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="#E0F2FE" />
    </LinearLayout>

    <!-- 대형 지도 그래픽 영역 (Map View Graphic Area) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="220dp"
        app:cardBackgroundColor="#0F172A"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        android:layout_marginBottom="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <!-- 격자 및 도로 배경 느낌 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PLEOS LIVE MAP ENGINE"
                android:textColor="#334155"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true" />

            <!-- 경로 선 및 마커 라인 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_centerInParent="true">

                <!-- 마커 아이콘 행 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🟢 판교"
                        android:textColor="#A7F3D0"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_weight="1"
                        android:background="#38BDF8"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp" />

                    <!-- 실시간 차 위치 -->
                    <TextView
                        android:id="@+id/tvLiveCarMarker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚗 김플레오 (65 km/h)"
                        android:textColor="#38BDF8"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:padding="6dp"
                        android:background="#1E293B" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_weight="0.8"
                        android:background="#475569"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvDestMarker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏁 강남역"
                        android:textColor="#F43F5E"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 하단 좌표 정보 -->
                <TextView
                    android:id="@+id/tvGeoCoords"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="위도: N 37.4979°  |  경도: E 127.0276° (경부고속도로 하행선)"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:paddingTop="16dp" />

            </LinearLayout>

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- 지도 하단 정보 박스 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/tvDestAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 목적지: 서울특별시 강남구 강남대로 396 (강남역)"
            android:textColor="#1E293B"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/tvEtaAndSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱️ 남은 거리/시간: 14.2 km / 약 22분 예상"
            android:textColor="#2563EB"
            android:textSize="14sp"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/tvVehicleStateDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚘 차량 정보: Hyundai IONIQ 5 / 문 닫힘 / 안전벨트 착용"
            android:textColor="#64748B"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>