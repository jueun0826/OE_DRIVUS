<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC"
    android:padding="20dp">

    <!-- 1. 고정 상단 헤더 Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvUnifiedDialogTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🚗 김플레오님의 프로필"
            android:textColor="#0F172A"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- 주행 / 정차 / 비운행 상태 뱃지 (초록색 #16A34A 통일) -->
        <TextView
            android:id="@+id/tvUnifiedStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● 주행 중"
            android:textColor="#16A34A"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="#DCFCE7" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0"
        android:layout_marginBottom="12dp" />

    <!-- 스크롤 가능한 메인 프로필 & 지도 & 타임라인 컨텐츠 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadeScrollbars="false"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 2. [상단] 친구 프로필 카드 (기존보다 1.5배 확장) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="16dp"
                android:paddingBottom="20dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="12dp"
                android:background="#FFFFFF">

                <!-- 1.5배 확대된 원형 프로필 아바타 이미지 카드 (80dp x 80dp) -->
                <androidx.cardview.widget.CardView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    app:cardCornerRadius="40dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardElevation="2dp"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:id="@+id/imgProfileAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/icon_friend_324976"
                        android:scaleType="fitCenter"
                        android:padding="3dp"
                        android:contentDescription="친구 프로필 이미지" />

                    <TextView
                        android:id="@+id/tvProfileAvatar"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                </androidx.cardview.widget.CardView>

                <!-- 친구 이름 (26sp Bold) -->
                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="김플레오"
                    android:textColor="#1D1E21"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <!-- 친구 아이디 (14sp) -->
                <TextView
                    android:id="@+id/tvProfileHandle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ID: pleo_kim"
                    android:textColor="#64748B"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:paddingTop="4dp" />

                <!-- 친구 차종 정보 (검정색 #1D1E21, 이모지 제거) -->
                <TextView
                    android:id="@+id/tvProfileVehicle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="차종: IONIQ 6"
                    android:textColor="#1D1E21"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingTop="2dp" />

                <!-- 친구 한줄 소개 (밖에서 보는 것과 똑같은 20sp 적용) -->
                <TextView
                    android:id="@+id/tvProfileBio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💬 &quot;오늘도 안운! 강남역 만날 사람~~ &quot;"
                    android:textColor="#2563EB"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingTop="8dp" />

            </LinearLayout>

            <!-- 3. 주행 중인 친구 지도 섹션 타이틀 (24sp Bold) -->
            <TextView
                android:id="@+id/tvNavSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 현재 친구 위치"
                android:textColor="#0F172A"
                android:textSize="24sp"
                android:textStyle="bold"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <!-- 주행 중인 친구 전용 실시간 네비게이션 화면 (정차/미이용 시 안내 텍스트 표출) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardNavContainer"
                android:layout_width="match_parent"
                android:layout_height="480dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#F8FAFC"
                app:cardElevation="2dp"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:id="@+id/imgRealNavMap"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/nav_map_pleo"
                    android:scaleType="fitCenter"
                    android:contentDescription="친구 실시간 네비게이션 화면" />

                <!-- 정차 중 / 비운행 중일 때 표출되는 안내 텍스트 (이모지 제거) -->
                <TextView
                    android:id="@+id/tvNavNoticeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="현재 차량 정차 중입니다."
                    android:textColor="#D97706"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <com.example.oe.PleosNavSimulationView
                    android:id="@+id/pleosNavView"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </androidx.cardview.widget.CardView>

            <!-- 4. 친구 타임라인 섹션 타이틀 (24sp Bold) -->
            <TextView
                android:id="@+id/tvTimelineTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="최근 한 달간 주행 타임라인"
                android:textColor="#0F172A"
                android:textSize="24sp"
                android:textStyle="bold"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <!-- 친구 타임라인 지도 & 방문 장소 카드 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardTimelineContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- 지도상에 1달간 방문 장소를 선으로 이어서 나타내는 커스텀 타임라인 뷰 -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        android:layout_marginBottom="16dp">

                        <com.example.oe.TimelinePathView
                            android:id="@+id/timelinePathView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </androidx.cardview.widget.CardView>

                    <!-- 최근 방문 장소 동적 리스트 (20sp 적용) -->
                    <LinearLayout
                        android:id="@+id/layoutTimelineItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- 하단 우측 버튼 바 (닫기) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingTop="10dp">

        <Button
            android:id="@+id/btnUnifiedClose"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="✖️ 닫기"
            android:textColor="#374151"
            android:backgroundTint="#E2E8F0"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>