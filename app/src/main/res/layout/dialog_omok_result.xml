<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="24dp">

    <!-- 승리 결과 텍스트 (창의 약 60% 영역 차지하는 44sp 대형 볼드 글자) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏆"
            android:textSize="54sp"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/tvOmokWinnerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="내 차(User) 승!"
            android:textColor="#0F172A"
            android:textSize="44sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <!-- 하단 우측 배치: [게임 재신청] 및 [닫기] 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingTop="12dp">

        <Button
            android:id="@+id/btnReplayOmok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔄 게임 재신청"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7C3AED"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/btnCloseOmokResult"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="✖️ 닫기"
            android:textColor="#374151"
            android:backgroundTint="#E2E8F0"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>