<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC"
    android:padding="20dp">

    <!-- 상단 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btnBackFromWordRelay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◀️ 미니게임 목록"
            android:textColor="#334155"
            android:backgroundTint="#F1F5F9"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔤 1:1 드라이브 끝말잇기"
            android:textColor="#0F172A"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWordScoreBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐ 이어간 단어: 4개"
            android:textColor="#059669"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="#ECFDF5"
            android:padding="8dp" />
    </LinearLayout>

    <!-- 끝말잇기 제시어 대형 카드 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 현재 마지막 단어 (다음 제시어: '브')"
                android:textColor="#64748B"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvConsonantPrompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ 드라이브 ]"
                android:textColor="#059669"
                android:textSize="36sp"
                android:textStyle="bold"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="예시: 브레이크, 브라운, 브라질..."
                android:textColor="#94A3B8"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 실시간 끝말잇기 단어 피드 리스트 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvWordLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🟢 [실시간 끝말잇기 단어 피드]&#10;• 김플레오: 자동차&#10;• 내 차(User): 차선&#10;• 김플레오: 선글라스&#10;• 내 차(User): 스노우타이어&#10;• 김플레오: 어라운드뷰&#10;• 내 차(User): 뷰티&#10;• 김플레오: 티켓&#10;• 내 차(User): 드라이브"
            android:textColor="#334155"
            android:textSize="15sp"
            android:padding="12dp"
            android:background="#FFFFFF" />
    </ScrollView>

    <!-- 단어 입력 및 제출 바 (imeOptions 적용) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etWordInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="'브'로 시작하는 단어를 입력하세요..."
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:layout_marginEnd="8dp"
            android:inputType="text"
            android:imeOptions="flagNoExtractUi" />

        <Button
            android:id="@+id/btnSubmitWord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔤 제출"
            android:textColor="#FFFFFF"
            android:backgroundTint="#059669"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnCloseWordRelay"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="✖️ 닫기"
            android:textColor="#374151"
            android:backgroundTint="#E2E8F0"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>