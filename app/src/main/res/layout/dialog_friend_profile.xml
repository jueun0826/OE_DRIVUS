<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- SNS 프로필 상단 아바타 (원형 뱃지) -->
    <androidx.cardview.widget.CardView
        android:layout_width="90dp"
        android:layout_height="90dp"
        app:cardCornerRadius="45dp"
        app:cardBackgroundColor="#F1F5F9"
        app:cardElevation="4dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvProfileAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="👨‍✈️"
            android:textSize="50sp"
            android:gravity="center" />
    </androidx.cardview.widget.CardView>

    <!-- 프로필 이름 및 아이디 -->
    <TextView
        android:id="@+id/tvProfileName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="김플레오"
        android:textColor="#0F172A"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvProfileHandle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ID: pleo_kim"
        android:textColor="#64748B"
        android:textSize="13sp"
        android:paddingBottom="8dp" />

    <!-- 프로필 상태 메시지 (Bio) -->
    <TextView
        android:id="@+id/tvProfileBio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💬 &quot;오늘도 안전 운전! 강남역에서 약속 있어요 🏁&quot;"
        android:textColor="#2563EB"
        android:textSize="14sp"
        android:textStyle="bold"
        android:paddingBottom="16dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0"
        android:layout_marginBottom="16dp" />

    <!-- 목적지 및 차량 실시간 운행 정보 카드 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#F8FAFC">

        <TextView
            android:id="@+id/tvProfileDest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 목적지: 서울특별시 강남구 강남대로 396 (강남역)"
            android:textColor="#1E293B"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/tvProfileSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚗 주행 상태: 65 km/h (주행 중 🚗)"
            android:textColor="#0284C7"
            android:textSize="14sp"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/tvProfileEta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱️ 남은 거리/시간: 14.2 km / 약 22분 예상"
            android:textColor="#2563EB"
            android:textSize="14sp"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/tvProfileVehicleInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚘 차량 연동: IONIQ 5 / 도어 닫힘 / 안전벨트 착용 완료"
            android:textColor="#64748B"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 하단 버튼 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingTop="16dp">

        <Button
            android:id="@+id/btnProfileClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="닫기"
            android:textColor="#475569"
            android:backgroundTint="#E2E8F0"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnProfileSendNav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="내 차 내비로 목적지 전송 📍"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2563EB" />
    </LinearLayout>

</LinearLayout>